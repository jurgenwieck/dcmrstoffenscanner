VITE_DCMR_API_BASE_URL=/api

# Gebruik deze alleen voor een snelle demo zonder APIM/proxy.
# Zet hier de volledige Logic App HTTP trigger URL in je lokale .env.production.
VITE_ANALYZE_SUBSTANCES_URL=
